rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: admin or supervisor
    function isAdminOrSupervisor() {
      let role = get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
      return request.auth != null && (role == 'admin' || role == 'supervisor');
    }

    // Users collection
    match /users/{userId} {
      // Permitir lectura a usuarios autenticados (para verificar si es el primer usuario)
      allow read: if isAuthenticated();
      // Permitir crear solo el propio documento de usuario
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Solo el propio usuario o admin puede actualizar/eliminar
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Detailed Employees collection (datos de colaboradores)
    match /detailed_employees/{employeeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Attendance Logs collection (registros de asistencia)
    match /attendance_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Permission Requests collection (solicitudes de permisos)
    match /permission_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Employee Schedules collection (horarios)
    match /employee_schedules/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Incomes collection (registros de ingresos económicos)
    match /incomes/{incomeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Legacy collections (mantener por compatibilidad)
    match /attendance/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Menu Configuration collection (configuración de menú RH)
    match /menu_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // App Settings collection (tolerancia, mensajes motivacionales)
    match /app_settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Tardiness Adjustments collection (ajustes de retardos)
    match /tardiness_adjustments/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Announcements collection (anuncios)
    match /announcements/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrSupervisor();
      allow update, delete: if isAdmin();
    }

    // Payroll Cuts collection (cortes de nomina)
    match /payroll_cuts/{docId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAdmin();
    }
  }
}
